<UserControl x:Class="USDX_Move.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="950"
             Background="#F4F6F9"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Geometry x:Key="MoveFolderIconGeometry">M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M13,13V9H15V13H18L14,17L10,13H13M13,3.5L18.5,9H13V3.5Z</Geometry>
        <Geometry x:Key="ImageIconGeometry">M21,19V5C21,3.89 20.1,3 19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19M8.5,13.5L11,16.5L14.5,12L19,18H5L8.5,13.5Z</Geometry>
        <Geometry x:Key="TimerIconGeometry">M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z</Geometry>
        <Geometry x:Key="WallpaperIconGeometry">M4,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M4,6V18H20V6H4M6,9A2,2 0 0,1 8,7A2,2 0 0,1 10,9A2,2 0 0,1 8,11A2,2 0 0,1 6,9M19,17H5L10,12L13,15L15,13L19,17Z</Geometry>
        <Geometry x:Key="CopyIconGeometry">M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z</Geometry>
        <Geometry x:Key="PlaylistIconGeometry">M4,3H20V5H4V3M4,7H20V9H4V7M4,11H14V13H4V11M17,12A3,3 0 1,1 14,15A3,3 0 0,1 17,12M17,10A5,5 0 1,0 22,15V3H20V11.54A4.96,4.96 0 0,0 17,10Z</Geometry>

        <Style x:Key="ToolCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cardBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="20">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="cardBorder" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="cardBorder" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="USDX Tool Suite" FontSize="26" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Select a tool to manage your UltraStar files and folders" FontSize="14" Foreground="#64748B" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Tools Grid -->
        <WrapPanel Grid.Row="2" Orientation="Horizontal">
            <!-- Move Folders Card -->
            <Button Style="{StaticResource ToolCardButtonStyle}" Width="270" Height="180" Margin="0,0,24,24" Click="BtnMoveFolders_Click">
                <StackPanel>
                    <Border Background="#EFF6FF" Width="48" Height="48" CornerRadius="10" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <Path Data="{StaticResource MoveFolderIconGeometry}" Fill="#2563EB" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Move Folders" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
                    <TextBlock Text="Selectively browse, filter, and move song folders to a new destination folder." 
                               TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,6,0,0" LineHeight="16"/>
                </StackPanel>
            </Button>

            <!-- Find Image Card -->
            <Button Style="{StaticResource ToolCardButtonStyle}" Width="270" Height="180" Margin="0,0,24,24" Click="BtnFindImage_Click">
                <StackPanel>
                    <Border Background="#FEF3C7" Width="48" Height="48" CornerRadius="10" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <Path Data="{StaticResource ImageIconGeometry}" Fill="#D97706" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Find Image" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
                    <TextBlock Text="Locate songs missing artwork or video, search covers online, and sync your song text files." 
                               TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,6,0,0" LineHeight="16"/>
                </StackPanel>
            </Button>

            <!-- Check Timing Card -->
            <Button Style="{StaticResource ToolCardButtonStyle}" Width="270" Height="180" Margin="0,0,24,24" Click="BtnCheckTiming_Click">
                <StackPanel>
                    <Border Background="#FEE2E2" Width="48" Height="48" CornerRadius="10" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <Path Data="{StaticResource TimerIconGeometry}" Fill="#DC2626" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Check Timing" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
                    <TextBlock Text="Scan your song library to identify songs with potential #GAP timing and lyric desync issues." 
                               TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,6,0,0" LineHeight="16"/>
                </StackPanel>
            </Button>

            <!-- Fix Background Card -->
            <Button Style="{StaticResource ToolCardButtonStyle}" Width="270" Height="180" Margin="0,0,24,24" Click="BtnFixBackground_Click">
                <StackPanel>
                    <Border Background="#ECFDF5" Width="48" Height="48" CornerRadius="10" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <Path Data="{StaticResource WallpaperIconGeometry}" Fill="#059669" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Fix Background" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
                    <TextBlock Text="Find songs with a cover image but missing #BACKGROUND, and set the background to match the cover." 
                               TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,6,0,0" LineHeight="16"/>
                </StackPanel>
            </Button>

            <!-- Dedupe Songs Card -->
            <Button Style="{StaticResource ToolCardButtonStyle}" Width="270" Height="180" Margin="0,0,24,24" Click="BtnDedupeSongs_Click">
                <StackPanel>
                    <Border Background="#F3E8FF" Width="48" Height="48" CornerRadius="10" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <Path Data="{StaticResource CopyIconGeometry}" Fill="#9333EA" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Dedupe Songs" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
                    <TextBlock Text="Find duplicate songs by Artist/Title, prioritize keeping video (AVI) versions, and move duplicates to trash." 
                               TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,6,0,0" LineHeight="16"/>
                </StackPanel>
            </Button>

            <!-- Playlist Editor Card -->
            <Button Style="{StaticResource ToolCardButtonStyle}" Width="270" Height="180" Margin="0,0,24,24" Click="BtnPlaylistEditor_Click">
                <StackPanel>
                    <Border Background="#EDE9FE" Width="48" Height="48" CornerRadius="10" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <Path Data="{StaticResource PlaylistIconGeometry}" Fill="#7C3AED" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Playlist Editor" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
                    <TextBlock Text="Create and edit UltraStar playlists, browse songs, and preview tracks before adding them." TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,6,0,0" LineHeight="16"/>
                </StackPanel>
            </Button>
        </WrapPanel>
    </Grid>
</UserControl>
