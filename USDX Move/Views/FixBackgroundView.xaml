<UserControl x:Class="USDX_Move.Views.FixBackgroundView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1050"
             Background="#F4F6F9"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Geometry x:Key="BackArrowGeometry">M20,11H7.83L13.42,5.41L12,4L4,12L12,20L13.41,18.59L7.83,13H20V11Z</Geometry>
        <Geometry x:Key="FolderIconGeometry">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</Geometry>
        <Geometry x:Key="SearchGeometry">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</Geometry>
        <Geometry x:Key="ClearGeometry">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</Geometry>
        <Geometry x:Key="CheckCircleGeometry">M12 2C6.5 2 2 6.5 2 12S6.5 22 12 22 22 17.5 22 12 17.5 2 12 2M10 17L5 12L6.41 10.59L10 14.17L17.59 6.58L19 8L10 17Z</Geometry>
        <Geometry x:Key="ImageIconGeometry">M21,19V5C21,3.89 20.1,3 19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19M8.5,13.5L11,16.5L14.5,12L19,18H5L8.5,13.5Z</Geometry>
        <Geometry x:Key="FlashGeometry">M7,2V13H10V22L17,10H13L17,2H7Z</Geometry>
        <Geometry x:Key="SaveGeometry">M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z</Geometry>

        <Style x:Key="BrowseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EBF1FA"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DCE7F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SongListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EBF1FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Back Navigation Bar -->
            <RowDefinition Height="Auto"/> <!-- Folder Scan Bar -->
            <RowDefinition Height="Auto"/> <!-- Action Bar (Fix All) -->
            <RowDefinition Height="*"/>    <!-- Main Content Area -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP NAVIGATION BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnBackToMenu" Style="{StaticResource BrowseButtonStyle}" Click="BtnBackToMenu_Click" ToolTip="Return to Main Menu">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource BackArrowGeometry}" Fill="#475569" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="Back to Menu" FontWeight="SemiBold" Foreground="#334155" FontSize="13"/>
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1" Text="Fix Background Tool" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </Grid>

        <!-- SCAN FOLDER BAR -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Songs Root:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" FontSize="13"/>
                <TextBox x:Name="TxtScanFolder" Grid.Column="1" Style="{StaticResource TextBoxStyle}"/>
                <Button x:Name="BtnBrowse" Grid.Column="3" Style="{StaticResource BrowseButtonStyle}" Click="BtnBrowse_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource FolderIconGeometry}" Fill="#F59E0B" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Browse..."/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnScan" Grid.Column="5" Style="{StaticResource ActionButtonStyle}" Background="#2563EB" Foreground="#FFFFFF" Click="BtnScan_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource SearchGeometry}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Scan for Missing Backgrounds"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ACTION BAR -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Songs Missing #BACKGROUND Property" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="#1E293B"/>

            <Button x:Name="BtnFixAll" Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Background="#16A34A" Foreground="#FFFFFF" Click="BtnFixAll_Click" IsEnabled="False" ToolTip="Set #BACKGROUND to match #COVER for all detected songs">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource FlashGeometry}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtFixAllBtn" Text="Fix All Missing Backgrounds (0)"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- MAIN 2-COLUMN CONTENT -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" MinWidth="375"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: List of Songs Missing Background -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & Count -->
                        <RowDefinition Height="Auto"/> <!-- Search Filter Box -->
                        <RowDefinition Height="*"/>    <!-- ListBox -->
                        <RowDefinition Height="Auto"/> <!-- Info tip -->
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Detected Songs" FontWeight="SemiBold" Foreground="#1E293B" FontSize="14" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="TxtMissingCount" Text="0 songs" Foreground="#64748B" FontSize="12" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                    </DockPanel>

                    <!-- Filter Box -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <TextBox x:Name="TxtFilter" Style="{StaticResource TextBoxStyle}" Padding="28,6,26,6" FontSize="12" TextChanged="TxtFilter_TextChanged"/>
                        <Path Data="{StaticResource SearchGeometry}" Fill="#94A3B8" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Filter songs..." Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="29,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtFilter}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button x:Name="BtnClearFilter" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnClearFilter_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtFilter}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Data="{StaticResource ClearGeometry}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <!-- Song ListBox -->
                    <ListBox x:Name="LstSongs" Grid.Row="2" SelectionMode="Single"
                             ItemContainerStyle="{StaticResource SongListItemStyle}"
                             BorderThickness="1" BorderBrush="#E2E8F0"
                             SelectionChanged="LstSongs_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding RelativePath}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Path Grid.Column="0" Data="{StaticResource ImageIconGeometry}" Fill="#D97706" Width="16" Height="16" Stretch="Uniform" Margin="0,2,10,0" VerticalAlignment="Top"/>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding FolderName}" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="#64748B" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                            <Run Text="Cover: "/>
                                            <Run Text="{Binding CoverFileName}" FontWeight="SemiBold"/>
                                            <Run Text=" | Background: [Missing]"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Status / Checkmark -->
                                    <Border Grid.Column="2" Padding="6,2" CornerRadius="4" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFixed}" Value="True">
                                                        <Setter Property="Background" Value="#D1FAE5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource CheckCircleGeometry}" Fill="#10B981" Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFixed}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Missing BG"/>
                                                        <Setter Property="Foreground" Value="#B45309"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFixed}" Value="True">
                                                                <Setter Property="Text" Value="Fixed"/>
                                                                <Setter Property="Foreground" Value="#059669"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="3" Text="Select a song to preview its cover and set it as background" Foreground="#94A3B8" FontSize="11" Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <!-- RIGHT PANE: Details & Cover Preview -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header / Song metadata -->
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>    <!-- Cover Image Preview -->
                        <RowDefinition Height="Auto"/> <!-- Action Button -->
                    </Grid.RowDefinitions>

                    <!-- Song Info Header -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock x:Name="TxtSelectedSongName" Text="No Song Selected" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock x:Name="TxtSelectedSongSub" Text="Select a song from the list to preview" FontSize="12" Foreground="#64748B" Margin="0,3,0,10"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Current #COVER:" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtCoverTagVal" Grid.Row="0" Grid.Column="1" Text="-" FontWeight="SemiBold" Foreground="#1E293B" FontSize="12" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="#BACKGROUND:" Foreground="#64748B" FontSize="12"/>
                                <TextBlock x:Name="TxtBackgroundTagVal" Grid.Row="1" Grid.Column="1" Text="-" FontWeight="SemiBold" Foreground="#D97706" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Cover Image Preview -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Cover Image Preview (Will be set as Background):" FontWeight="SemiBold" Foreground="#334155" FontSize="13" Margin="0,0,0,10"/>

                            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="ImgCoverPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock x:Name="TxtNoImageNotice" Text="No preview available" Foreground="#94A3B8" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Fix Selected Action Button -->
                    <Border Grid.Row="3" Margin="0,14,0,0" Padding="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock x:Name="TxtFeedback" Text="" Foreground="#10B981" FontWeight="Medium" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <Button x:Name="BtnFixSelected" Style="{StaticResource ActionButtonStyle}" Background="#16A34A" Foreground="#FFFFFF" HorizontalAlignment="Right" DockPanel.Dock="Right" Click="BtnFixSelected_Click" IsEnabled="False" ToolTip="Set #BACKGROUND to match #COVER for this song">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource SaveGeometry}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtFixSelectedBtn" Text="Set Background = Cover Image"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="4" Margin="0,14,0,0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Ready. Choose a songs root folder and click Scan." Foreground="#475569" FontSize="12" VerticalAlignment="Center"/>
                <ProgressBar x:Name="ProgScan" Grid.Column="1" Width="160" Height="14" Visibility="Collapsed" IsIndeterminate="False"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
