<UserControl x:Class="USDX_Move.Views.CheckTimingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:USDX_Move.Models"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1050"
             Background="#F4F6F9"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Geometry x:Key="BackArrowGeometry">M20,11H7.83L13.42,5.41L12,4L4,12L12,20L13.41,18.59L7.83,13H20V11Z</Geometry>
        <Geometry x:Key="FolderIconGeometry">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</Geometry>
        <Geometry x:Key="SearchGeometry">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</Geometry>
        <Geometry x:Key="ClearGeometry">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</Geometry>
        <Geometry x:Key="WarningGeometry">M12,2L1,21H23L12,2M12,6L19.53,19H4.47L12,6M11,10V14H13V10H11M11,16V18H13V16H11Z</Geometry>
        <Geometry x:Key="CheckCircleGeometry">M12 2C6.5 2 2 6.5 2 12S6.5 22 12 22 22 17.5 22 12 17.5 2 12 2M10 17L5 12L6.41 10.59L10 14.17L17.59 6.58L19 8L10 17Z</Geometry>
        <Geometry x:Key="HelpCircleGeometry">M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M11,16.5H13V18.5H11V16.5M12,6.5A3.5,3.5 0 0,0 8.5,10H10.5A1.5,1.5 0 0,1 12,8.5A1.5,1.5 0 0,1 13.5,10C13.5,11.5 11.25,11.25 11.25,13.5H12.75C12.75,12 15,11.75 15,10A3.5,3.5 0 0,0 12,6.5Z</Geometry>
        <Geometry x:Key="ExternalLinkGeometry">M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z</Geometry>
        <Geometry x:Key="TrashIconGeometry">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</Geometry>
        <Geometry x:Key="UndoIconGeometry">M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z</Geometry>
        <Geometry x:Key="MoveIconGeometry">M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M13,13V9H15V13H18L14,17L10,13H13M13,3.5L18.5,9H13V3.5Z</Geometry>

        <Style x:Key="BrowseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EBF1FA"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DCE7F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,6,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimingListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EBF1FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Navigation Bar -->
            <RowDefinition Height="Auto"/> <!-- Folder Scan & Trash Settings Bar -->
            <RowDefinition Height="*"/>    <!-- Main Content Area -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP NAVIGATION BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnBackToMenu" Style="{StaticResource BrowseButtonStyle}" Click="BtnBackToMenu_Click" ToolTip="Return to Main Menu">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource BackArrowGeometry}" Fill="#475569" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="Back to Menu" FontWeight="SemiBold" Foreground="#334155" FontSize="13"/>
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1" Text="Check Timing &amp; GAP Tool" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </Grid>

        <!-- SCAN & TRASH CONFIGURATION BAR -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0: Songs Root Folder & Scan -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Songs Root:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" FontSize="12"/>
                <TextBox x:Name="TxtScanFolder" Grid.Row="0" Grid.Column="1" Style="{StaticResource TextBoxStyle}"/>
                <Button x:Name="BtnBrowse" Grid.Row="0" Grid.Column="3" Style="{StaticResource BrowseButtonStyle}" Click="BtnBrowse_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource FolderIconGeometry}" Fill="#F59E0B" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0"/>
                        <TextBlock Text="Browse..."/>
                    </StackPanel>
                </Button>

                <!-- Tolerance Selector -->
                <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tolerance:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" FontSize="12" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbTolerance" Width="68" SelectedIndex="2" SelectionChanged="CmbTolerance_SelectionChanged">
                        <ComboBoxItem Content="1.0s"/>
                        <ComboBoxItem Content="1.5s"/>
                        <ComboBoxItem Content="2.0s"/>
                        <ComboBoxItem Content="2.5s"/>
                        <ComboBoxItem Content="3.0s"/>
                    </ComboBox>
                </StackPanel>

                <Button x:Name="BtnScan" Grid.Row="0" Grid.Column="7" Style="{StaticResource ActionButtonStyle}" Background="#2563EB" Foreground="#FFFFFF" Click="BtnScan_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource SearchGeometry}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Scan &amp; Check Timing"/>
                    </StackPanel>
                </Button>

                <!-- Row 2: Trash Destination Folder & Move Action -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Trash Folder:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#DC2626" FontSize="12"/>
                <TextBox x:Name="TxtTrashFolder" Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBoxStyle}" TextChanged="TxtTrashFolder_TextChanged"/>
                <Button x:Name="BtnBrowseTrash" Grid.Row="2" Grid.Column="3" Style="{StaticResource BrowseButtonStyle}" Click="BtnBrowseTrash_Click" ToolTip="Select folder where broken songs will be moved">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource FolderIconGeometry}" Fill="#DC2626" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0"/>
                        <TextBlock Text="Browse..."/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnMoveTrash" Grid.Row="2" Grid.Column="5" Grid.ColumnSpan="3" Style="{StaticResource ActionButtonStyle}" Background="#DC2626" Foreground="#FFFFFF" Click="BtnMoveTrash_Click" IsEnabled="False" ToolTip="Move all songs marked as trash to the selected Trash folder">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource MoveIconGeometry}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtMoveTrashBtn" Text="Move Marked Songs (0)"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- MAIN 2-COLUMN CONTENT -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" MinWidth="375"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: Song List with Filter Tabs -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Filter Chips -->
                        <RowDefinition Height="Auto"/> <!-- Search Filter Box -->
                        <RowDefinition Height="*"/>    <!-- ListBox -->
                    </Grid.RowDefinitions>

                    <!-- Filter Tabs -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <RadioButton x:Name="RadFilterAll" Content="All (0)" Style="{StaticResource FilterRadioButtonStyle}" IsChecked="True" Checked="FilterRadio_Checked"/>
                        <RadioButton x:Name="RadFilterIssues" Content="⚠️ Issues (0)" Style="{StaticResource FilterRadioButtonStyle}" Checked="FilterRadio_Checked"/>
                        <RadioButton x:Name="RadFilterOk" Content="✓ OK (0)" Style="{StaticResource FilterRadioButtonStyle}" Checked="FilterRadio_Checked"/>
                        <RadioButton x:Name="RadFilterUnmatched" Content="❓ Unmatched (0)" Style="{StaticResource FilterRadioButtonStyle}" Checked="FilterRadio_Checked"/>
                        <RadioButton x:Name="RadFilterTrash" Content="🗑️ Marked for Move (0)" Style="{StaticResource FilterRadioButtonStyle}" Checked="FilterRadio_Checked"/>
                    </WrapPanel>

                    <!-- Filter Box -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <TextBox x:Name="TxtFilter" Style="{StaticResource TextBoxStyle}" Padding="28,6,26,6" FontSize="12" TextChanged="TxtFilter_TextChanged"/>
                        <Path Data="{StaticResource SearchGeometry}" Fill="#94A3B8" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Filter songs..." Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="29,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtFilter}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button x:Name="BtnClearFilter" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnClearFilter_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtFilter}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Data="{StaticResource ClearGeometry}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <!-- Songs ListBox -->
                    <ListBox x:Name="LstSongs" Grid.Row="2" SelectionMode="Single"
                             ItemContainerStyle="{StaticResource TimingListItemStyle}"
                             BorderThickness="1" BorderBrush="#E2E8F0"
                             SelectionChanged="LstSongs_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" CornerRadius="6" Margin="0,1">
                                    <!-- Dynamic Background when Marked for Trash -->
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMarkedForTrash}" Value="True">
                                                    <Setter Property="Background" Value="#FFF1F2"/>
                                                    <Setter Property="BorderBrush" Value="#FDA4AF"/>
                                                    <Setter Property="BorderThickness" Value="2,0,0,0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid ToolTip="{Binding RelativePath}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Icon -->
                                        <Grid Grid.Column="0" Margin="0,2,8,0" VerticalAlignment="Top">
                                            <!-- Normal Warning Icon (when not trash) -->
                                            <Path Data="{StaticResource WarningGeometry}" Fill="#EF4444" Width="16" Height="16" Stretch="Uniform">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Status}" Value="{x:Static models:TimingStatus.TimingIssue}"/>
                                                                    <Condition Binding="{Binding IsMarkedForTrash}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>

                                            <!-- Trash Icon (when marked for trash) -->
                                            <Path Data="{StaticResource TrashIconGeometry}" Fill="#DC2626" Width="16" Height="16" Stretch="Uniform">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMarkedForTrash}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>

                                            <!-- Check Circle (when OK and not trash) -->
                                            <Path Data="{StaticResource CheckCircleGeometry}" Fill="#10B981" Width="16" Height="16" Stretch="Uniform">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Status}" Value="{x:Static models:TimingStatus.Ok}"/>
                                                                    <Condition Binding="{Binding IsMarkedForTrash}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>

                                            <!-- Help Circle (when unmatched and not trash) -->
                                            <Path Data="{StaticResource HelpCircleGeometry}" Fill="#94A3B8" Width="16" Height="16" Stretch="Uniform">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Status}" Value="{x:Static models:TimingStatus.NoReferenceFound}"/>
                                                                    <Condition Binding="{Binding IsMarkedForTrash}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>

                                        <!-- Song Details -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding FolderName}" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Foreground="#64748B" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Artist, TargetNullValue='Unknown Artist'}"/>
                                                <Run Text=" - "/>
                                                <Run Text="{Binding Title, TargetNullValue='Unknown Title'}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Badges: Trash Badge & Delta Badge -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <!-- Trash Badge -->
                                            <Border Padding="6,2" CornerRadius="4" Background="#FEE2E2" Margin="0,0,6,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMarkedForTrash}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="🗑️ Trash" FontSize="10" FontWeight="Bold" Foreground="#DC2626"/>
                                            </Border>

                                            <!-- Delta Badge -->
                                            <Border Padding="6,2" CornerRadius="4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TimingStatus.TimingIssue}">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TimingStatus.Ok}">
                                                                <Setter Property="Background" Value="#D1FAE5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding DeltaText}" FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TimingStatus.TimingIssue}">
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TimingStatus.Ok}">
                                                                    <Setter Property="Foreground" Value="#059669"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- RIGHT PANE: Detailed Timing Inspection Diagnostics -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Song Title / Status / Trash Toggle Header -->
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>    <!-- Timing Breakdown Panels -->
                        <RowDefinition Height="Auto"/> <!-- Open Folder Button -->
                    </Grid.RowDefinitions>

                    <!-- Song Header with Trash Toggle Button -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Song Titles -->
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtSelectedSongName" Text="No Song Selected" FontSize="16" FontWeight="Bold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtSelectedSongSub" Text="Select a song from the list to inspect timing breakdown" FontSize="12" Foreground="#64748B" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Status Badge -->
                            <Border x:Name="BadgeStatus" Grid.Column="1" Padding="10,4" CornerRadius="6" Background="#E2E8F0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSelectedStatus" Text="Pending" FontWeight="Bold" FontSize="12" Foreground="#475569"/>
                            </Border>

                            <!-- Trash Toggle Button (Mark / Unmark) -->
                            <Button x:Name="BtnToggleTrash" Grid.Column="3" Style="{StaticResource ActionButtonStyle}" Background="#FFF1F2" Foreground="#DC2626" BorderBrush="#FECDD3" BorderThickness="1" VerticalAlignment="Center" Click="BtnToggleTrash_Click" IsEnabled="False" ToolTip="Toggle marking this broken song to move to Trash">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="IconToggleTrash" Data="{StaticResource TrashIconGeometry}" Fill="#DC2626" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtToggleTrash" Text="Mark for Trash"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Timing Comparison Details -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- UltraStar File Breakdown Card -->
                            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="UltraStar File Timing Parameters" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,12"/>
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="#GAP Property:" Foreground="#64748B" FontSize="13" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="TxtGapVal" Grid.Row="0" Grid.Column="1" Text="-" FontWeight="SemiBold" Foreground="#1E293B" FontSize="13" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="#BPM Property:" Foreground="#64748B" FontSize="13" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="TxtBpmVal" Grid.Row="1" Grid.Column="1" Text="-" FontWeight="SemiBold" Foreground="#1E293B" FontSize="13" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="First Sung Note:" Foreground="#64748B" FontSize="13" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="TxtFirstNoteVal" Grid.Row="2" Grid.Column="1" Text="-" FontWeight="SemiBold" Foreground="#1E293B" FontSize="13" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Calculated Vocal Start:" Foreground="#2563EB" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock x:Name="TxtCalcVocalVal" Grid.Row="3" Grid.Column="1" Text="-" FontWeight="Bold" Foreground="#2563EB" FontSize="13"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Online Reference Comparison Card -->
                            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Online Synced Lyrics Reference (LRCLIB)" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,12"/>
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Reference First Line:" Foreground="#64748B" FontSize="13" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="TxtRefLineVal" Grid.Row="0" Grid.Column="1" Text="-" FontWeight="SemiBold" Foreground="#1E293B" FontSize="13" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Reference Vocal Start:" Foreground="#64748B" FontSize="13" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="TxtRefVocalVal" Grid.Row="1" Grid.Column="1" Text="-" FontWeight="SemiBold" Foreground="#1E293B" FontSize="13" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Timing Discrepancy:" Foreground="#64748B" FontSize="13"/>
                                        <TextBlock x:Name="TxtDeltaVal" Grid.Row="2" Grid.Column="1" Text="-" FontWeight="Bold" FontSize="13"/>
                                    </Grid>

                                    <!-- Diagnosis Note -->
                                    <Border x:Name="BoxDiagnosis" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,14,0,0">
                                        <TextBlock x:Name="TxtDiagnosis" Text="Diagnosis details will appear here." Foreground="#475569" FontSize="12" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Action Button -->
                    <Border Grid.Row="3" Margin="0,14,0,0" Padding="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock Text="Check and adjust in UltraStar / Song Editor if needed" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <Button x:Name="BtnOpenFolder" Style="{StaticResource ActionButtonStyle}" Background="#3B82F6" Foreground="#FFFFFF" HorizontalAlignment="Right" DockPanel.Dock="Right" Click="BtnOpenFolder_Click" IsEnabled="False" ToolTip="Open this song folder in Windows Explorer">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource ExternalLinkGeometry}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="Open Song Folder in Explorer"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="3" Margin="0,14,0,0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Ready. Choose a songs folder and click Scan &amp; Check Timing." Foreground="#475569" FontSize="12" VerticalAlignment="Center"/>
                <ProgressBar x:Name="ProgScan" Grid.Column="1" Width="160" Height="14" Visibility="Collapsed" IsIndeterminate="False"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
