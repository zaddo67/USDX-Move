<UserControl x:Class="USDX_Move.Views.PlaylistEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9" FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Geometry x:Key="BackArrow">M20,11H7.83L13.42,5.41L12,4L4,12L12,20L13.41,18.59L7.83,13H20V11Z</Geometry>
        <Geometry x:Key="FolderIcon">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</Geometry>
        <Geometry x:Key="SearchIcon">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</Geometry>
        <Geometry x:Key="PlusIcon">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</Geometry>
        <Geometry x:Key="TrashIcon">M9,3V4H4V6H5V21A2,2 0 0,0 7,23H17A2,2 0 0,0 19,21V6H20V4H15V3H9M7,6H17V21H7V6M9,8V19H11V8H9M13,8V19H15V8H13Z</Geometry>
        <Geometry x:Key="PlayIcon">M8,5.14V19.14L19,12.14L8,5.14Z</Geometry>
        <Geometry x:Key="StopIcon">M6,6H18V18H6V6Z</Geometry>
        <Geometry x:Key="ForwardIcon">M4,4V20L12,12L4,4M12,4V20L20,12L12,4Z</Geometry>
        <Geometry x:Key="SaveIcon">M17,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3M12,19A3,3 0 1,1 12,13A3,3 0 0,1 12,19M6,8V5H15V8H6Z</Geometry>
        <Style x:Key="TextBoxStyle" TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D0D5DD"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ButtonBase" TargetType="Button"><Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Opacity" Value=".88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Opacity" Value=".72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D0D5DD"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}"><Setter Property="Background" Value="#FFF1F2"/><Setter Property="Foreground" Value="#DC2626"/><Setter Property="BorderBrush" Value="#FECDD3"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="ListItem" TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="border" CornerRadius="6" Background="Transparent"><ContentPresenter Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#EFF6FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="border" Property="Background" Value="#DBEAFE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}"><Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#BFDBFE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#2563EB"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="border" Width="30" Height="30" CornerRadius="15" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </UserControl.Resources>
    <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Style="{StaticResource BrowseButton}" Click="BtnBack_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource BackArrow}" Fill="#475569" Width="14" Height="14" Margin="0,0,8,0"/><TextBlock Text="Back to Menu" Foreground="#334155"/></StackPanel></Button><TextBlock Grid.Column="1" Text="Playlist Editor" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Text="Songs Root:" FontWeight="SemiBold" Foreground="#334155" FontSize="12" VerticalAlignment="Center"/><TextBox x:Name="TxtSongsFolder" Grid.Row="0" Grid.Column="1" Style="{StaticResource TextBoxStyle}" TextChanged="Folder_TextChanged"/><Button Grid.Row="0" Grid.Column="3" Style="{StaticResource BrowseButton}" Click="BtnBrowseSongs_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource FolderIcon}" Fill="#F59E0B" Width="15" Height="15" Margin="0,0,5,0"/><TextBlock Text="Browse..." Foreground="#334155"/></StackPanel></Button>
            <TextBlock Grid.Row="2" Text="Playlists:" FontWeight="SemiBold" Foreground="#334155" FontSize="12" VerticalAlignment="Center"/><TextBox x:Name="TxtPlaylistsFolder" Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBoxStyle}" TextChanged="Folder_TextChanged"/><Button Grid.Row="2" Grid.Column="3" Style="{StaticResource BrowseButton}" Click="BtnBrowsePlaylists_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource FolderIcon}" Fill="#8B5CF6" Width="15" Height="15" Margin="0,0,5,0"/><TextBlock Text="Browse..." Foreground="#334155"/></StackPanel></Button><Button Grid.Row="0" Grid.Column="5" Grid.RowSpan="3" Style="{StaticResource PrimaryButton}" Click="BtnLoadFolders_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource SearchIcon}" Fill="White" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="Load Songs &amp; Playlists"/></StackPanel></Button>
            <Border Grid.Row="4" Grid.ColumnSpan="6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Playlist:" FontWeight="SemiBold" Foreground="#334155" FontSize="12" VerticalAlignment="Center"/><ComboBox x:Name="CmbPlaylists" Grid.Column="1" Height="31" DisplayMemberPath="Name" SelectionChanged="CmbPlaylists_SelectionChanged"/><TextBlock Grid.Column="3" Text="Name:" FontWeight="SemiBold" Foreground="#334155" FontSize="12" VerticalAlignment="Center"/><TextBox x:Name="TxtPlaylistName" Grid.Column="4" Style="{StaticResource TextBoxStyle}"/><StackPanel Grid.Column="6" Orientation="Horizontal"><Button Style="{StaticResource BrowseButton}" Click="BtnNew_Click" Content="New"/><Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="BtnSave_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource SaveIcon}" Fill="White" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="Save Playlist"/></StackPanel></Button><Button Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="BtnDeletePlaylist_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource TrashIcon}" Fill="#DC2626" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="Delete"/></StackPanel></Button></StackPanel></Grid></Border>
        </Grid></Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><TextBlock Text="Available Songs" FontWeight="SemiBold" Foreground="#334155" FontSize="15" DockPanel.Dock="Left"/><TextBlock x:Name="TxtSongCount" Text="0 songs" Foreground="#64748B" FontSize="12" DockPanel.Dock="Right"/></DockPanel><Grid Grid.Row="1" Margin="0,0,0,8"><TextBox x:Name="TxtSongSearch" Style="{StaticResource TextBoxStyle}" Padding="28,6,26,6" TextChanged="TxtSongSearch_TextChanged"/><Path Data="{StaticResource SearchIcon}" Fill="#94A3B8" Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/><Button HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="6" Click="BtnClearSongSearch_Click" Content="Clear" Foreground="#64748B"/></Grid><ListBox x:Name="LstSongs" Grid.Row="2" ItemContainerStyle="{StaticResource ListItem}" BorderBrush="#E2E8F0" BorderThickness="1" SelectionChanged="LstSongs_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Grid Margin="10,7"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid Width="20" Height="20" Margin="0,1,10,0" Visibility="{Binding IsInPlaylist, Converter={StaticResource BoolToVisibility}}"><Ellipse Fill="#10B981"/><TextBlock Text="✓" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#1E293B" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding PlaylistStatus}" Foreground="#059669" FontSize="11" Margin="0,2,0,0"/></StackPanel><Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Add to playlist" Click="BtnQuickAdd_Click"><Path Data="{StaticResource PlusIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16"/></Button></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="3" Text="Select a song to preview it, or use + to add it to the playlist." Foreground="#94A3B8" FontSize="11" Margin="0,8,0,0"/></Grid></Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="76" Height="76" CornerRadius="6" Background="#E2E8F0"><Image x:Name="ImgCover" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="TxtSelectedSong" Text="Select a song" FontWeight="SemiBold" Foreground="#1E293B" FontSize="15" TextWrapping="Wrap"/><TextBlock x:Name="TxtAudioStatus" Foreground="#64748B" FontSize="11" Margin="0,3,0,7"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource PrimaryButton}" Click="BtnAddSelected_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource PlusIcon}" Fill="White" Width="14" Height="14" Margin="0,0,5,0"/><TextBlock Text="Add"/></StackPanel></Button><Button Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BtnPlay_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource PlayIcon}" Fill="#2563EB" Width="13" Height="13" Margin="0,0,5,0"/><TextBlock Text="Play" Foreground="#334155"/></StackPanel></Button><Button Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BtnSkipForward_Click" ToolTip="Advance preview by 10 seconds"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource ForwardIcon}" Fill="#2563EB" Width="13" Height="13" Margin="0,0,5,0"/><TextBlock Text="+10s" Foreground="#334155"/></StackPanel></Button><Button Style="{StaticResource BrowseButton}" Margin="8,0,0,0" Click="BtnStop_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource StopIcon}" Fill="#64748B" Width="12" Height="12" Margin="0,0,5,0"/><TextBlock Text="Stop" Foreground="#334155"/></StackPanel></Button></StackPanel></StackPanel></Grid></Border>
                <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><TextBlock Text="Playlist Songs" FontWeight="SemiBold" Foreground="#334155" FontSize="15" DockPanel.Dock="Left"/><TextBlock x:Name="TxtPlaylistCount" Text="0 songs" Foreground="#64748B" FontSize="12" DockPanel.Dock="Right"/></DockPanel><Grid Grid.Row="1" Margin="0,0,0,8"><TextBox x:Name="TxtPlaylistSearch" Style="{StaticResource TextBoxStyle}" Padding="28,6,26,6" TextChanged="TxtPlaylistSearch_TextChanged"/><Path Data="{StaticResource SearchIcon}" Fill="#94A3B8" Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/><Button HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="6" Click="BtnClearPlaylistSearch_Click" Content="Clear" Foreground="#64748B"/></Grid><ListBox x:Name="LstPlaylist" Grid.Row="2" ItemContainerStyle="{StaticResource ListItem}" BorderBrush="#E2E8F0" BorderThickness="1"><ListBox.ItemTemplate><DataTemplate><Grid Margin="10,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#1E293B" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding PlaylistEntry}" Foreground="#64748B" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Style="{StaticResource IconButton}" Background="#FFF1F2" BorderBrush="#FECDD3" Foreground="#DC2626" ToolTip="Remove from playlist" Click="BtnDeleteSong_Click"><Path Data="{StaticResource TrashIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15"/></Button></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="3" Text="Use the delete button to remove a song from this playlist." Foreground="#94A3B8" FontSize="11" Margin="0,8,0,0"/></Grid></Grid></Border>
        </Grid>
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,14,0,0"><TextBlock x:Name="TxtStatus" Foreground="#475569" FontSize="12"/></Border>
    </Grid>
</UserControl>
