<UserControl x:Class="USDX_Move.Views.PlaylistEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9" FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="LabelStyle" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#334155"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
        <Style x:Key="TextBoxStyle" TargetType="TextBox"><Setter Property="Padding" Value="8,5"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="6,0,0,0"/></Style>
    </UserControl.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Playlist Editor" FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Grid.Row="2" Style="{StaticResource LabelStyle}" Text="Songs folder:"/>
                <TextBox x:Name="TxtSongsFolder" Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBoxStyle}" TextChanged="Folder_TextChanged"/>
                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Browse…" Click="BtnBrowseSongs_Click"/>
                <TextBlock Grid.Row="4" Style="{StaticResource LabelStyle}" Text="Playlists folder:"/>
                <TextBox x:Name="TxtPlaylistsFolder" Grid.Row="4" Grid.Column="1" Style="{StaticResource TextBoxStyle}" TextChanged="Folder_TextChanged"/>
                <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Content="Browse…" Click="BtnBrowsePlaylists_Click"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Load folders" Click="BtnLoadFolders_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Available Songs" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B"/>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSongSearch" Style="{StaticResource TextBoxStyle}" TextChanged="TxtSongSearch_TextChanged" ToolTip="Search artist or title"/>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Clear" Click="BtnClearSongSearch_Click"/>
                    </Grid>
                    <ListBox x:Name="LstSongs" Grid.Row="4" SelectionChanged="LstSongs_SelectionChanged" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding PlaylistStatus}" Foreground="#059669" FontSize="11"/></StackPanel>
                                <TextBlock Grid.Column="1" Text="✓" Foreground="#059669" FontSize="16" Margin="8,0" Visibility="{Binding IsInPlaylist, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Button Grid.Column="2" Content="+" ToolTip="Add to playlist" FontSize="17" Padding="8,0" Click="BtnQuickAdd_Click"/>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="96" Height="96" Background="#E2E8F0"><Image x:Name="ImgCover" Stretch="UniformToFill"/></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="TxtSelectedSong" Text="Select a song" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="TxtAudioStatus" Foreground="#64748B" Margin="0,4,0,8"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource PrimaryButton}" Content="Add" Click="BtnAddSelected_Click"/><Button Style="{StaticResource SecondaryButton}" Content="Play" Click="BtnPlay_Click"/><Button Style="{StaticResource SecondaryButton}" Content="Stop" Click="BtnStop_Click"/></StackPanel></StackPanel>
                    </Grid>
                    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel><TextBlock Text="Playlist" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" DockPanel.Dock="Left"/><TextBlock x:Name="TxtPlaylistCount" Text="0 songs" Foreground="#64748B" VerticalAlignment="Bottom" HorizontalAlignment="Right"/></DockPanel>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TxtPlaylistSearch" Style="{StaticResource TextBoxStyle}" TextChanged="TxtPlaylistSearch_TextChanged" ToolTip="Search playlist"/><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Clear" Click="BtnClearPlaylistSearch_Click"/></Grid>
                        <ListBox x:Name="LstPlaylist" Grid.Row="4" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Content="Delete" Click="BtnDeleteSong_Click"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,14,0,0"><Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="← Back to Menu" Click="BtnBack_Click"/><TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Foreground="#475569" Margin="14,0"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="Playlist:" VerticalAlignment="Center" FontWeight="SemiBold"/><ComboBox x:Name="CmbPlaylists" Width="170" DisplayMemberPath="Name" SelectionChanged="CmbPlaylists_SelectionChanged"/><TextBox x:Name="TxtPlaylistName" Width="155" Margin="8,0,0,0" Style="{StaticResource TextBoxStyle}" ToolTip="Playlist name"/><Button Style="{StaticResource SecondaryButton}" Content="New" Click="BtnNew_Click"/><Button Style="{StaticResource PrimaryButton}" Content="Save" Click="BtnSave_Click"/><Button Style="{StaticResource SecondaryButton}" Content="Delete playlist" Click="BtnDeletePlaylist_Click"/></StackPanel></DockPanel>
    </Grid>
</UserControl>
