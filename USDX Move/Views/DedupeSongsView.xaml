<UserControl x:Class="USDX_Move.Views.DedupeSongsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:USDX_Move.Models"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1050"
             Background="#F4F6F9"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Geometry x:Key="BackArrowGeometry">M20,11H7.83L13.42,5.41L12,4L4,12L12,20L13.41,18.59L7.83,13H20V11Z</Geometry>
        <Geometry x:Key="FolderIconGeometry">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</Geometry>
        <Geometry x:Key="SearchGeometry">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</Geometry>
        <Geometry x:Key="ClearGeometry">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</Geometry>
        <Geometry x:Key="MoveIconGeometry">M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M13,13V9H15V13H18L14,17L10,13H13M13,3.5L18.5,9H13V3.5Z</Geometry>
        <Geometry x:Key="VideoIconGeometry">M18,3H6A3,3 0 0,0 3,6V18A3,3 0 0,0 6,21H18A3,3 0 0,0 21,18V6A3,3 0 0,0 18,3M10,8.5L16,12L10,15.5V8.5Z</Geometry>
        <Geometry x:Key="ImageIconGeometry">M21,19V5C21,3.89 20.1,3 19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19M8.5,13.5L11,16.5L14.5,12L19,18H5L8.5,13.5Z</Geometry>
        <Geometry x:Key="CheckCircleGeometry">M12 2C6.5 2 2 6.5 2 12S6.5 22 12 22 22 17.5 22 12 17.5 2 12 2M10 17L5 12L6.41 10.59L10 14.17L17.59 6.58L19 8L10 17Z</Geometry>
        <Geometry x:Key="TrashIconGeometry">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</Geometry>
        <Geometry x:Key="ExternalLinkGeometry">M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z</Geometry>

        <Style x:Key="BrowseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EBF1FA"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DCE7F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EBF1FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Navigation Bar -->
            <RowDefinition Height="Auto"/> <!-- Scan & Trash Folder Bar -->
            <RowDefinition Height="*"/>    <!-- Main Content Area -->
            <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP NAVIGATION BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnBackToMenu" Style="{StaticResource BrowseButtonStyle}" Click="BtnBackToMenu_Click" ToolTip="Return to Main Menu">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource BackArrowGeometry}" Fill="#475569" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="Back to Menu" FontWeight="SemiBold" Foreground="#334155" FontSize="13"/>
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1" Text="Dedupe Songs Tool" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </Grid>

        <!-- SCAN & TRASH CONFIGURATION BAR -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0: Songs Root Folder & Scan -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Songs Root:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" FontSize="12"/>
                <TextBox x:Name="TxtScanFolder" Grid.Row="0" Grid.Column="1" Style="{StaticResource TextBoxStyle}"/>
                <Button x:Name="BtnBrowse" Grid.Row="0" Grid.Column="3" Style="{StaticResource BrowseButtonStyle}" Click="BtnBrowse_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource FolderIconGeometry}" Fill="#F59E0B" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0"/>
                        <TextBlock Text="Browse..."/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnScan" Grid.Row="0" Grid.Column="5" Style="{StaticResource ActionButtonStyle}" Background="#2563EB" Foreground="#FFFFFF" Click="BtnScan_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource SearchGeometry}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Scan for Duplicates"/>
                    </StackPanel>
                </Button>

                <!-- Row 2: Trash Destination Folder & Move Duplicates Action -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Trash Folder:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#DC2626" FontSize="12"/>
                <TextBox x:Name="TxtTrashFolder" Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBoxStyle}" TextChanged="TxtTrashFolder_TextChanged"/>
                <Button x:Name="BtnBrowseTrash" Grid.Row="2" Grid.Column="3" Style="{StaticResource BrowseButtonStyle}" Click="BtnBrowseTrash_Click" ToolTip="Select destination folder for duplicate songs">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource FolderIconGeometry}" Fill="#DC2626" Width="15" Height="15" Stretch="Uniform" Margin="0,0,5,0"/>
                        <TextBlock Text="Browse..."/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnMoveDuplicates" Grid.Row="2" Grid.Column="5" Style="{StaticResource ActionButtonStyle}" Background="#DC2626" Foreground="#FFFFFF" Click="BtnMoveDuplicates_Click" IsEnabled="False" ToolTip="Move all versions marked for trash to the destination trash folder">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource MoveIconGeometry}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtMoveDuplicatesBtn" Text="Move Duplicates (0)"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- MAIN 2-COLUMN CONTENT -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480" MinWidth="360"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: Duplicate Song Groups List -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & Count -->
                        <RowDefinition Height="Auto"/> <!-- Search Filter Box -->
                        <RowDefinition Height="*"/>    <!-- ListBox -->
                        <RowDefinition Height="Auto"/> <!-- Help tip -->
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Duplicate Song Groups" FontWeight="SemiBold" Foreground="#1E293B" FontSize="14" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="TxtGroupCount" Text="0 groups" Foreground="#64748B" FontSize="12" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                    </DockPanel>

                    <!-- Filter Box -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <TextBox x:Name="TxtFilter" Style="{StaticResource TextBoxStyle}" Padding="28,6,26,6" FontSize="12" TextChanged="TxtFilter_TextChanged"/>
                        <Path Data="{StaticResource SearchGeometry}" Fill="#94A3B8" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Filter duplicate songs..." Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="29,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtFilter}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button x:Name="BtnClearFilter" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnClearFilter_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtFilter}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Data="{StaticResource ClearGeometry}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <!-- Duplicate Groups ListBox -->
                    <ListBox x:Name="LstGroups" Grid.Row="2" SelectionMode="Single"
                             ItemContainerStyle="{StaticResource GroupListItemStyle}"
                             BorderThickness="1" BorderBrush="#E2E8F0"
                             SelectionChanged="LstGroups_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Path Grid.Column="0" Data="{StaticResource FolderIconGeometry}" Fill="#D97706" Width="18" Height="18" Stretch="Uniform" Margin="0,2,10,0" VerticalAlignment="Top"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding DisplayArtist}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding DisplayTitle}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SummaryText}" Foreground="#64748B" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Copies Badge -->
                                    <Border Grid.Column="2" Padding="8,2" CornerRadius="10" Background="#FEF3C7" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding TotalCopies, StringFormat='{}{0} copies'}" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="3" Text="Select a group to compare versions and choose which to keep" Foreground="#94A3B8" FontSize="11" Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <!-- RIGHT PANE: Comparison of All Versions in the Group -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Group Title Header -->
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>    <!-- Scrollable Versions Comparison List -->
                    </Grid.RowDefinitions>

                    <!-- Group Title Header -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtSelectedGroupTitle" Text="No Group Selected" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock x:Name="TxtSelectedGroupSub" Text="Select a duplicate song group from the left to inspect versions" FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                            </StackPanel>

                            <TextBlock x:Name="TxtPreferenceNote" Grid.Column="1" Text="Priority: AVI/Video > Cover Image" FontSize="11" FontWeight="SemiBold" Foreground="#059669" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Versions Comparison Cards -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LstVersions">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12" CornerRadius="8" BorderThickness="1" Padding="14">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsKeep}" Value="True">
                                                        <Setter Property="Background" Value="#F0FDF4"/>
                                                        <Setter Property="BorderBrush" Value="#86EFAC"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsKeep}" Value="False">
                                                        <Setter Property="Background" Value="#FFF1F2"/>
                                                        <Setter Property="BorderBrush" Value="#FECDD3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Folder name and Status Badge -->
                                            <DockPanel Grid.Row="0">
                                                <!-- Status Badge (Keep vs Move to Trash) -->
                                                <Border DockPanel.Dock="Right" Padding="10,4" CornerRadius="6" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsKeep}" Value="True">
                                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="12" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="🗑️ MOVE TO TRASH"/>
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsKeep}" Value="True">
                                                                        <Setter Property="Text" Value="🟢 KEEP THIS VERSION"/>
                                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource FolderIconGeometry}" Fill="#F59E0B" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding FolderName}" FontWeight="Bold" FontSize="14" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Row 2: Relative Path & Tags Info -->
                                            <StackPanel Grid.Row="2">
                                                <TextBlock Text="{Binding RelativePath}" Foreground="#64748B" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                                                <WrapPanel Orientation="Horizontal">
                                                    <!-- Video Tag Badge -->
                                                    <Border Padding="8,3" CornerRadius="4" Margin="0,0,8,4">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasVideo}" Value="True">
                                                                        <Setter Property="Background" Value="#DBEAFE"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource VideoIconGeometry}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Fill" Value="#94A3B8"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasVideo}" Value="True">
                                                                                <Setter Property="Fill" Value="#2563EB"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="No Video"/>
                                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasVideo}" Value="True">
                                                                                <Setter Property="Text" Value="{Binding VideoTag, StringFormat='Video: {0}'}"/>
                                                                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Cover Tag Badge -->
                                                    <Border Padding="8,3" CornerRadius="4" Margin="0,0,8,4" Background="#F1F5F9">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource ImageIconGeometry}" Fill="#D97706" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0"/>
                                                            <TextBlock Text="{Binding CoverTag, StringFormat='Cover: {0}'}" FontSize="11" Foreground="#475569"/>
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Row 4: Action Buttons (Keep Toggle & Open Folder) -->
                                            <DockPanel Grid.Row="4">
                                                <Button DockPanel.Dock="Left" Style="{StaticResource BrowseButtonStyle}" Click="BtnOpenVersionFolder_Click" ToolTip="Open this folder in Windows Explorer">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource ExternalLinkGeometry}" Fill="#475569" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Open in Explorer" FontSize="11"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Select as Keep Button -->
                                                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Click="BtnSetKeepVersion_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                                            <Setter Property="Background" Value="#16A34A"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Setter Property="Content" Value="✓ Set as Version to Keep"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsKeep}" Value="True">
                                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                                    <Setter Property="Content" Value="✓ Currently Selected to Keep"/>
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="3" Margin="0,14,0,0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Ready. Choose a songs root folder and click Scan for Duplicates." Foreground="#475569" FontSize="12" VerticalAlignment="Center"/>
                <ProgressBar x:Name="ProgScan" Grid.Column="1" Width="160" Height="14" Visibility="Collapsed" IsIndeterminate="False"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
